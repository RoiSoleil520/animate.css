{
  "name": "animate.css",
  "version": "3.7.1",
  "main": "animate.css",
  "module": "lib/index.css",
  "exports": {
    ".": {
      "import": "./lib/index.css",
      "require": "./animate.css"
    },
    "./lib/*": "./lib/*",
    "./animate.css": "./animate.css",
    "./animate.min.css": "./animate.min.css"
  },
  "files": [
    "animate.css",
    "animate.min.css",
    "lib/",
    "source/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/daneden/animate.css.git"
  },
  "author": {
    "name": "Daniel Eden"
  },
  "homepage": "https://daneden.github.io/animate.css/",
  "license": "MIT",
  "style": "./animate.css",
  "jspm": {
    "main": "animate.css!",
    "format": "global",
    "directories": {
      "lib": "./"
    }
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "cssnano": "^6.0.1",
    "eslint": "^8.57.0",
    "gulp": "^4.0.2",
    "gulp-concat": "^2.6.1",
    "gulp-header": "^2.0.5",
    "gulp-postcss": "^9.0.1",
    "gulp-rename": "^2.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1"
  },
  "lint-staged": {
    "*.{js,json,md,css}": [
      "prettier --write",
      "git add"
    ]
  },
  "prettier": {
    "bracketSpacing": false,
    "proseWrap": "never",
    "singleQuote": true,
    "trailingComma": "all"
  },
  "scripts": {
    "gulp": "./node_modules/gulp/bin/gulp.js",
    "start": "gulp",
    "build": "gulp",
    "build:modular": "gulp modular",
    "prettier": "prettier --write \"**/*.{js,json,md,css}\"",
    "precommit": "lint-staged",
    "optimize": "node optimize-animations.js && node advanced-optimize.js"
  },
  "spm": {
    "main": "./animate.css"
  }
}
